PORT=8080
RUNNER_SECRET=dev-secret
# Defaults to python3 (python on Windows). Override if your interpreter is
# on a different name/path.
PYTHON_BIN=python
# Defaults to runner/vendor/soplang — populate it with
# scripts/fetch-soplang.sh (or .ps1 on Windows) before starting the runner.
SOPLANG_SRC_DIR=
