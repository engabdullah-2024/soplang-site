# URL of the sandboxed Soplang execution service (see runner/README.md).
# Leave unset in development to run the site with the playground disabled.
SOPLANG_RUNNER_URL=

# Shared secret sent as the X-Runner-Secret header on every request to the
# runner, so it only accepts calls from this site. Must match the runner's
# own RUNNER_SECRET env var.
SOPLANG_RUNNER_SECRET=
